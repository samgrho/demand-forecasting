# Copy to .env and fill in.

# How site operators can reach you about this scraper (email or URL).
# Sent in the User-Agent header; OpenStreetMap and Wikimedia ask for it.
SCRAPER_CONTACT=

# Free key from https://developer.ticketmaster.com/ (Discovery API).
# Leave blank to skip Ticketmaster.
TICKETMASTER_API_KEY=

# Optional tuning
# MIN_HOST_INTERVAL=2.0     # seconds between requests to the same site (robots.txt Crawl-delay wins if larger)
# REQUEST_TIMEOUT=20
# CACHE_PATH=data/cache.sqlite3
